# Copy to `.env.dev.local` (gitignored) for local development.
#
# `.env` in this directory holds the committed defaults — base path and the
# Venho theme knobs. Anything environment-specific or secret belongs here
# instead, and values set here win over `.env`.

# The ZITADEL instance this login app fronts. No trailing slash.
# Dev:  https://auth.dev.venho.ai
# Prod: not settled yet — see VENHO.md.
ZITADEL_API_URL=https://auth.dev.venho.ai

# Personal access token of a machine user holding the "Instance Login Client"
# (IAM_LOGIN_CLIENT) role on that instance. The app cannot start a session
# without it. Treat it as a secret: never commit it, and in a deployment mount
# it as a file and use ZITADEL_SERVICE_USER_TOKEN_FILE instead.
ZITADEL_SERVICE_USER_TOKEN=

# `.env` points ZITADEL_SERVICE_USER_TOKEN_FILE at upstream's local-dev pat
# file. If you are using the inline token above, blank the file variable so the
# app does not try to read a path that isn't there.
ZITADEL_SERVICE_USER_TOKEN_FILE=

# Require a verified email before a session is issued.
EMAIL_VERIFICATION=false
